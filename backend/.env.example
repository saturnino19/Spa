PORT=3000
NODE_ENV=development

# Opción 1: Cadena de conexión directa
DATABASE_URL=postgresql://spa_user:spa_password@localhost:5432/spa_db

# Opción 2: Variables individuales (usadas si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=spa_user
DB_PASSWORD=spa_password
DB_NAME=spa_db
