Enum user_status {
  active
  inactive
  deleted
  suspended
}

Enum client_type {
  new
  recurring
}

Enum availability_status {
  available
  unavailable
}

Enum payment_method {
  cash
  card
  transfer
}

Enum payment_status {
  pending
  paid
}

Enum appointment_status {
  pending
  completed
  cancelled
}

Enum kardex_movement_type {
  supplier_purchase
  direct_sale
  service_consumption
  inventory_count_adjustment
  product_return
}

Table roles {
  id int [pk, increment]
  name varchar(25) [unique, not null]
  description text
}

Table users {
  id int [pk, increment]
  role_id int [not null]
  first_name varchar(25) [not null]
  last_name varchar(25) [not null]
  email varchar(50) [unique, not null]
  password varchar(255) [not null]
  phone varchar(20)
  status user_status [not null, default: 'active']
  last_login_at timestamp [note: 'NULL indica que nunca ha iniciado sesión']
  created_at timestamp [not null, default: `now()`]
}

Table clients {
  id int [pk, increment]
  first_name varchar(25) [not null]
  last_name varchar(25) [not null]
  phone varchar(20)
  email varchar(50)
  address text
  client_type client_type [default: 'new']
  notes text
  registered_at timestamp [default: `now()`]
}

Table service_categories {
  id int [pk, increment]
  name varchar(100) [not null]
  description text
}

Table services {
  id int [pk, increment]
  category_id int [not null]
  name varchar(50) [not null]
  description text
  duration_minutes int [not null]
  price decimal(10,2) [not null]
  availability availability_status [default: 'available']
}

Table service_kits {
  id int [pk, increment]
  service_id int [not null]
  product_id int [not null]
  consumed_quantity decimal(10,2) [not null]

  Indexes {
    (service_id, product_id) [unique]
  }
}

Table appointments {
  id int [pk, increment]
  client_id int [not null]
  employee_id int [not null]
  appointment_datetime timestamp [not null]
  status appointment_status [default: 'pending']
  location varchar(30) [not null]
  home_address text
  notes text
  created_at timestamp [default: `now()`]
}

Table appointment_services {
  id int [pk, increment]
  appointment_id int [not null]
  service_id int [not null]
  applied_price decimal(10,2) [not null]
}

Table suppliers {
  id int [pk, increment]
  name varchar(50) [not null]
  contact_name varchar(50)
  phone varchar(20)
  email varchar(50)
  address text
  lead_time_days int [not null, default: 3]
  safety_stock_days int [not null, default: 2]
}

Table products {
  id int [pk, increment]
  supplier_id int [not null]
  barcode varchar(50) [unique, not null]
  name varchar(50) [not null]
  description text
  purchase_unit varchar(20) [not null, default: 'box']
  consumption_unit varchar(20) [not null, default: 'unit']
  conversion_factor decimal(10,2) [not null, default: 1]
  allows_decimals boolean [not null, default: false]
  purchase_price decimal(10,2) [not null]
  sale_price decimal(10,2) [not null]
}

Table kardex {
  id int [pk, increment]
  product_id int [not null]
  user_id int [not null]
  created_at timestamp [not null, default: `now()`]
  movement_type kardex_movement_type [not null]
  reference_document varchar(50) [not null]
  quantity decimal(10,2) [not null]
  unit_cost decimal(10,2) [not null]
  notes text

  Indexes {
    (reference_document, product_id, movement_type) [unique, name: 'uq_doc_prod_type']
    (product_id, created_at)
  }
}

Table physical_counts {
  id int [pk, increment]
  record_code varchar(30) [unique, not null]
  product_id int [not null]
  user_id int [not null]
  snapshot_at timestamp [not null]
  system_snapshot_stock decimal(10,2) [not null]
  physical_counted_stock decimal(10,2) [not null]
  adjustment_difference decimal(10,2) [not null]
}

Table invoices {
  id int [pk, increment]
  appointment_id int [note: 'Opcional para permitir ventas directas sin cita']
  client_id int [not null]
  user_id int [not null]
  issued_at timestamp [not null, default: `now()`]
  subtotal decimal(10,2) [not null]
  tax decimal(10,2) [not null]
  total decimal(10,2) [not null]
  payment_method payment_method [default: 'card']
}

Table invoice_details {
  id int [pk, increment]
  invoice_id int [not null]
  service_id int
  product_id int
  quantity decimal(10,2) [not null, default: 1]
  unit_price decimal(10,2) [not null]
  subtotal decimal(10,2) [not null]

  Note: 'CHECK chk_invoice_detail_item: debe existir exactamente service_id o product_id (exclusión mutua XOR).'
}

Table commissions {
  id int [pk, increment]
  employee_id int [not null]
  invoice_id int [not null]
  commission_amount decimal(10,2) [not null]
  created_at timestamp [not null, default: `now()`]
  status payment_status [default: 'pending']
}

Ref: users.role_id > roles.id [delete: restrict]
Ref: services.category_id > service_categories.id [delete: restrict]
Ref: service_kits.service_id > services.id [delete: cascade]
Ref: service_kits.product_id > products.id [delete: restrict]
Ref: appointments.client_id > clients.id [delete: restrict]
Ref: appointments.employee_id > users.id [delete: restrict]
Ref: appointment_services.appointment_id > appointments.id [delete: cascade]
Ref: appointment_services.service_id > services.id [delete: restrict]
Ref: products.supplier_id > suppliers.id [delete: restrict]
Ref: kardex.product_id > products.id [delete: restrict]
Ref: kardex.user_id > users.id [delete: restrict]
Ref: physical_counts.product_id > products.id [delete: restrict]
Ref: physical_counts.user_id > users.id [delete: restrict]
Ref: invoices.appointment_id > appointments.id [delete: restrict]
Ref: invoices.client_id > clients.id [delete: restrict]
Ref: invoices.user_id > users.id [delete: restrict]
Ref: invoice_details.invoice_id > invoices.id [delete: cascade]
Ref: invoice_details.service_id > services.id [delete: restrict]
Ref: invoice_details.product_id > products.id [delete: restrict]
Ref: commissions.employee_id > users.id [delete: restrict]
Ref: commissions.invoice_id > invoices.id [delete: restrict]
